# ---- Runtime --------------------------------------------------------------
ENVIRONMENT=local              # local | test | staging | production
LOG_LEVEL=INFO
LOG_JSON=false                 # true in production (structured logs)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- Database -------------------------------------------------------------
# Default: SQLite under server/data. Production: Postgres, e.g.
# DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
DATABASE_URL=
AUTO_CREATE_SCHEMA=true        # set false in production and run `alembic upgrade head`

# ---- Auth -----------------------------------------------------------------
AUTH_MODE=dev                  # dev | jwt | oidc   (dev is refused in staging/production)
AUTH_JWT_SECRET=               # required for AUTH_MODE=jwt (>= 32 random bytes)
AUTH_ISSUER=                   # required for oidc, e.g. https://your-tenant.okta.com/oauth2/default
AUTH_AUDIENCE=
AUTH_JWKS_URL=                 # required for oidc
AUTH_ORG_CLAIM=org
AUTH_ROLES_CLAIM=roles

# ---- LLM gateway (LangChain) ------------------------------------------------
LLM_PROVIDERS=openai,anthropic # ordered failover chain; unset keys are skipped
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
ALLOW_SIMULATOR_FALLBACK=true  # false = fail the run instead of degrading to simulated output

# ---- Budgets & limits -----------------------------------------------------
RUN_TOKEN_BUDGET=120000
ORG_DAILY_SPEND_USD=25
RUNS_PER_MINUTE=6
DEBATE_MAX_ROUNDS=2
RUN_ORPHAN_TIMEOUT_S=30        # cancel runs nobody is watching; 0 disables

# ---- Grounding ------------------------------------------------------------
TAVILY_API_KEY=                # enables web search + citations for the Researcher

# ---- Memory ---------------------------------------------------------------
USE_PROVIDER_EMBEDDINGS=false  # true = OpenAI embeddings instead of local hashing embedder

# ---- Observability --------------------------------------------------------
METRICS_TOKEN=                 # protects /api/v1/metrics (Prometheus)
OTEL_EXPORTER_OTLP_ENDPOINT=   # requires opentelemetry-exporter-otlp + instrumentation-fastapi
SENTRY_DSN=                    # requires sentry-sdk
# LangSmith tracing of every LangGraph node and LLM call:
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nexus

# ---- Self-hosted models (Ollama) ---------------------------------------------
# LLM_PROVIDERS=ollama   (or e.g. openai,ollama for failover)
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=16384
